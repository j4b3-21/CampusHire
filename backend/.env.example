# Backend on the host against the infrastructure stack (make infra-up) - DEVELOPMENT ONLY.
# Copy to backend/.env; read by the `local` profile (make backend). Properties format: KEY=value.
# Values must match infrastructure/.env.

SERVER_PORT=8080

PLATFORM_DB_HOST=localhost
PLATFORM_DB_PORT=5442
PLATFORM_DB=campushire
PLATFORM_DB_USER=campushire
PLATFORM_DB_PASSWORD=change-me-campushire-db

# Issuer http://localhost:8180/realms/campushire; JWKS derived from it
KEYCLOAK_HOST=localhost
KEYCLOAK_PORT=8180
KEYCLOAK_REALM=campushire
KEYCLOAK_AUDIENCE=campushire-api

OPENFGA_API_URL=http://localhost:8280
OPENFGA_PRESHARED_KEY=change-me-openfga-key
OPENFGA_STORE_NAME=campushire

REDIS_HOST=localhost
REDIS_PORT=6389

FILES_STORAGE=s3
S3_ENDPOINT=http://localhost:9100
S3_REGION=us-east-1
S3_BUCKET=campushire-files
S3_ACCESS_KEY=campushire-api
S3_SECRET_KEY=change-me-s3-secret
S3_PATH_STYLE=true

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=false
MAIL_FROM=placements@campushire.local

APP_BASE_URL=http://localhost:3000
