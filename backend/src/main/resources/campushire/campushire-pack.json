  ],
  "workflows": [
    {
      "module": "application",
      "field": "stage",
      "definition": {
        "initial": "applied",
        "states": [
          {"key": "applied", "label": "Applied", "category": "OPEN", "color": "slate"},
          {"key": "shortlisted", "label": "Shortlisted", "category": "IN_PROGRESS", "color": "blue"},
          {"key": "assessment", "label": "Assessment", "category": "IN_PROGRESS", "color": "violet"},
          {"key": "interview", "label": "Interview", "category": "IN_PROGRESS", "color": "amber"},
          {"key": "offered", "label": "Offered", "category": "WON", "color": "emerald"},
          {"key": "joined", "label": "Joined", "category": "WON", "color": "green"},
          {"key": "rejected", "label": "Rejected", "category": "LOST", "color": "red"},
          {"key": "withdrawn", "label": "Withdrawn", "category": "LOST", "color": "zinc"}
        ],
        "transitions": [
          {"key": "shortlist", "label": "Shortlist", "from": ["applied"], "to": "shortlisted", "roles": ["tpo", "coordinator", "recruiter"]},
          {"key": "assess", "label": "Move to assessment", "from": ["applied", "shortlisted"], "to": "assessment", "roles": ["tpo", "coordinator", "recruiter"]},
          {"key": "interview", "label": "Move to interview", "from": ["shortlisted", "assessment"], "to": "interview", "roles": ["tpo", "coordinator", "recruiter"]},
          {"key": "offer", "label": "Mark offered", "from": ["shortlisted", "assessment", "interview"], "to": "offered", "roles": ["tpo", "recruiter"]},
          {"key": "join", "label": "Mark joined", "from": ["offered"], "to": "joined", "roles": ["tpo", "coordinator"]},
          {"key": "reject", "label": "Reject", "from": ["applied", "shortlisted", "assessment", "interview"], "to": "rejected", "roles": ["tpo", "coordinator", "recruiter"]},
          {"key": "withdraw", "label": "Withdraw", "from": ["applied", "shortlisted"], "to": "withdrawn", "roles": ["student"]},
          {"key": "reopen", "label": "Reopen", "from": ["rejected", "withdrawn"], "to": "applied", "roles": ["tpo"], "requireComment": true}
        ]
      }
    }
  ]
