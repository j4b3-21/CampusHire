        "company": {"read": "ALL", "hiddenFields": ["notes"]},
        "contact": {"read": "ALL"},
        "job": {"read": "ALL"},
        "drive": {"read": "ALL"},
        "application": {"read": {"scope": "ATTRIBUTE", "field": "department", "attribute": "department"},
                        "update": {"scope": "ATTRIBUTE", "field": "department", "attribute": "department"},
