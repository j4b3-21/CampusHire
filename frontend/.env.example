# Keycloak (public client, Authorization Code + PKCE). Exposed to the browser.
NEXT_PUBLIC_KEYCLOAK_URL=http://localhost:8180
NEXT_PUBLIC_KEYCLOAK_REALM=campushire
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=campushire-web

# Where the Next.js server proxies /api/* (server-side only; the browser always calls relative /api/v1/...).
API_INTERNAL_URL=http://localhost:8090
