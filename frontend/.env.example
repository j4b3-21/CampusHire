# Copy to frontend/.env.local for `npm run dev` against the local stack (make infra-up + make backend).
# The browser calls relative /api/*; Next.js rewrites those requests to API_INTERNAL_URL.
API_INTERNAL_URL=http://localhost:8080
NEXT_PUBLIC_KEYCLOAK_URL=http://localhost:8180
NEXT_PUBLIC_KEYCLOAK_REALM=campushire
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=campushire-web
