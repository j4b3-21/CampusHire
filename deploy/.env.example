# CampusHire production configuration (deploy/docker-compose.prod.yml). Copy to deploy/.env and chmod 600 it.
# Replace EVERY change-me value; generate secrets with:  openssl rand -base64 32 | tr -d '/+=' | cut -c1-32
# Never commit deploy/.env. Database passwords apply only when the postgres volume is first created.

# ---- Release ----
# Image tag of campushire-backend / campushire-frontend (Jenkins sets the commit SHA).
IMAGE_TAG=latest

# ---- Public address ----
# Host name users type in the browser (also the nginx server_name and certificate name).
CAMPUSHIRE_DOMAIN=placements.example.edu
# Full public URL; defaults to https://${CAMPUSHIRE_DOMAIN}. Set it when HTTPS_PORT is not 443 (append :port).
# Token issuer, Keycloak hostname, e-mail links and the web app's Keycloak URL derive from it. The frontend image
# bakes it in at build time: rebuild after changing.
CAMPUSHIRE_PUBLIC_URL=
# Published nginx ports and bind address (only nginx is reachable from outside the Docker network).
HTTP_PORT=80
HTTPS_PORT=443
HTTP_BIND=0.0.0.0
# Directory with fullchain.pem and privkey.pem (relative to deploy/). See deploy/scripts/gen-self-signed-cert.sh
# and deploy/scripts/certbot.md.
CERTS_DIR=./certs

# ---- PostgreSQL 18 ----
POSTGRES_USER=campushire_admin
POSTGRES_PASSWORD=change-me-postgres-superuser-password
KEYCLOAK_DB=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=change-me-keycloak-db-password
OPENFGA_DB=openfga
OPENFGA_DB_USER=openfga
OPENFGA_DB_PASSWORD=change-me-openfga-db-password
PLATFORM_DB=campushire
PLATFORM_DB_USER=campushire
PLATFORM_DB_PASSWORD=change-me-campushire-db-password
# Tuning for the 8 vCPU / 16 GB reference host (ADR-006). For 8 GB: 2GB / 5GB / 8MB / 256MB, limit 3g.
PG_SHARED_BUFFERS=4GB
PG_EFFECTIVE_CACHE_SIZE=12GB
PG_WORK_MEM=16MB
PG_MAINTENANCE_WORK_MEM=512MB
# 2 API replicas x DB_POOL_SIZE + Keycloak 20 + OpenFGA 20 + backups/psql must stay below this.
PG_MAX_CONNECTIONS=200
PG_SHM_SIZE=1g
PG_LOG_MIN_DURATION=500ms
POSTGRES_MEM_LIMIT=6g

# ---- Keycloak 26 (served under /auth) ----
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-keycloak-admin-password
KEYCLOAK_MEM_LIMIT=1536m
KEYCLOAK_CPUS=2
# Sender of verification / password-reset mail (SMTP_* below are shared with the API).
KEYCLOAK_MAIL_FROM=no-reply@example.edu
KEYCLOAK_SMTP_AUTH=true
# Google sign-in. Redirect URI to register: <CAMPUSHIRE_PUBLIC_URL>/auth/realms/campushire/broker/google/endpoint
# Read at first realm import only; afterwards use scripts/configure-google-sso.sh (ENV_FILE=deploy/.env).
GOOGLE_IDP_ENABLED=false
GOOGLE_CLIENT_ID=change-me-google-client-id
GOOGLE_CLIENT_SECRET=change-me-google-client-secret
# Only accounts of this Google Workspace domain may sign in (empty = any Google account).
GOOGLE_HOSTED_DOMAIN=example.edu

# ---- OpenFGA ----
OPENFGA_PRESHARED_KEY=change-me-openfga-preshared-key
# Printed by deploy/scripts/openfga-bootstrap.sh (run once after the first `up`; --write-env fills them in).
OPENFGA_STORE_ID=
OPENFGA_MODEL_ID=
OPENFGA_CHECK_CACHE_ENABLED=false

# ---- Redis (cache, rate limits, SSE fan-out; no persistence) ----
REDIS_PASSWORD=change-me-redis-password
REDIS_MAXMEMORY=512mb

# ---- MinIO (resumes, offer letters, import files) ----
MINIO_ROOT_USER=campushire-minio
MINIO_ROOT_PASSWORD=change-me-minio-root-password
S3_REGION=us-east-1
S3_BUCKET=campushire-files
S3_ACCESS_KEY=campushire-api
S3_SECRET_KEY=change-me-s3-secret-key

# ---- Outgoing e-mail (bm4a/docs/operations/EMAIL.md). Empty SMTP_HOST: mail stays queued, nothing is sent. ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
SMTP_SSL=false
MAIL_FROM="CampusHire <placements@example.edu>"

# ---- API replicas (backend-1, backend-2) ----
# HikariCP connections per replica (ADR-006 budget: 30).
DB_POOL_SIZE=30
BACKEND_MEM_LIMIT=2g
BACKEND_CPUS=3
# JAVA_TOOL_OPTIONS of the API (the image already sets -XX:MaxRAMPercentage=75 -XX:+ExitOnOutOfMemoryError, so the
# heap is 75% of BACKEND_MEM_LIMIT: 1.5 GB per replica).
BACKEND_JAVA_OPTS="-XX:InitialRAMPercentage=50 -XX:+UseG1GC -XX:MaxGCPauseMillis=100"
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WRITES_PER_MINUTE=300
CAMPUSHIRE_TIME_ZONE=Asia/Kolkata
API_DOCS_ENABLED=false

# ---- Nginx rate limits ----
# Per access token (one signed-in user) and per client IP (campus NAT: keep high).
NGINX_API_RATE=50r/s
NGINX_API_BURST=100
NGINX_API_IP_RATE=2000r/s
NGINX_API_IP_BURST=4000
NGINX_AUTH_RATE=100r/s
NGINX_AUTH_BURST=200

# ---- Monitoring profile (docker compose --profile monitoring; Grafana at <public URL>/grafana/, private networks) ----
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana-admin-password
PROMETHEUS_RETENTION=15d

# ---- Backups (deploy/scripts/backup.sh) ----
BACKUP_DIR=/var/backups/campushire
BACKUP_RETENTION_DAYS=14
