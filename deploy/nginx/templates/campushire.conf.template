# CampusHire edge configuration. Rendered by the nginx image entrypoint (envsubst) from
# /etc/nginx/templates/*.template; ${CAMPUSHIRE_DOMAIN} comes from deploy/.env.
#
# Rate limits are per client IP and intentionally generous: a whole campus usually shares a few NAT addresses.
# Per-user write limits are enforced by the API (Redis).

limit_req_zone $binary_remote_addr zone=api_per_ip:20m rate=150r/s;
limit_req_zone $binary_remote_addr zone=auth_per_ip:10m rate=30r/s;
limit_req_status 429;

upstream campushire_api {
    least_conn;
    server backend-1:8080 max_fails=3 fail_timeout=10s;
    server backend-2:8080 max_fails=3 fail_timeout=10s;
    keepalive 64;
}

upstream campushire_web {
    server frontend:3000;
    keepalive 32;
}

upstream campushire_keycloak {
    server keycloak:8080;
    keepalive 16;
}

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      '';
}

server {
    listen 80;
    listen [::]:80;
    server_name ${CAMPUSHIRE_DOMAIN};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${CAMPUSHIRE_DOMAIN};

    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 1d;

    client_max_body_size 26m;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;

    proxy_http_version 1.1;
    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host  $host;
    proxy_set_header Connection        "";

    # Operational endpoints stay on the internal network.
    location /actuator/ {
        return 404;
    }

    # Server-Sent Events: no buffering, long-lived connections.
    location = /api/v1/notifications/stream {
        proxy_pass http://campushire_api;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 1h;
        add_header X-Accel-Buffering no;
    }

    location /api/ {
        limit_req zone=api_per_ip burst=300 nodelay;
        proxy_pass http://campushire_api;
        proxy_read_timeout 120s;
        proxy_next_upstream error timeout http_502 http_503;
        proxy_next_upstream_tries 2;
    }

    # Keycloak runs with KC_HTTP_RELATIVE_PATH=/auth behind this proxy.
    location /auth/ {
        limit_req zone=auth_per_ip burst=60 nodelay;
        proxy_pass http://campushire_keycloak;
        proxy_buffer_size 128k;
        proxy_buffers 4 256k;
        proxy_busy_buffers_size 256k;
    }

    location /auth/admin/ {
        allow 10.0.0.0/8;
        allow 172.16.0.0/12;
        allow 192.168.0.0/16;
        allow 127.0.0.1;
        deny all;
        proxy_pass http://campushire_keycloak;
    }

    location /_next/static/ {
        proxy_pass http://campushire_web;
        expires 1y;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    location / {
        proxy_pass http://campushire_web;
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
    }
}
