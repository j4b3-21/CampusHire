# CampusHire edge configuration. Rendered by the nginx image entrypoint (envsubst) from
# /etc/nginx/templates/*.template; ${CAMPUSHIRE_DOMAIN} and ${NGINX_*} come from deploy/.env.
#
# Rate limits: a whole campus usually shares a few NAT addresses, so the per-IP limit is only a flood guard and the
# real limit is per access token (keyed by the last 32 characters of the JWT signature; unauthenticated requests
# fall back to the client IP). Per-user write limits are also enforced by the API (Redis).

map $http_authorization $api_client_key {
    "~^Bearer\s+[A-Za-z0-9_-]+\.[A-Za-z0-9_-]+\.[A-Za-z0-9_-]*(?<sig>[A-Za-z0-9_-]{32})$" $sig;
    default $binary_remote_addr;
}

limit_req_zone $api_client_key     zone=api_per_client:32m rate=${NGINX_API_RATE};
limit_req_zone $binary_remote_addr zone=api_per_ip:10m     rate=${NGINX_API_IP_RATE};
limit_req_zone $binary_remote_addr zone=auth_per_ip:10m    rate=${NGINX_AUTH_RATE};
limit_req_status 429;

upstream campushire_api {
    zone campushire_api 64k;
    least_conn;
    server backend-1:8080 resolve max_fails=3 fail_timeout=10s;
    server backend-2:8080 resolve max_fails=3 fail_timeout=10s;
    keepalive 64;
    keepalive_requests 10000;
    keepalive_timeout 60s;
}

upstream campushire_web {
    zone campushire_web 64k;
    server frontend:3000 resolve;
    keepalive 32;
}

upstream campushire_keycloak {
    zone campushire_keycloak 64k;
    server keycloak:8080 resolve;
    keepalive 32;
}

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      '';
}

server {
    listen 80;
    listen [::]:80;
    server_name ${CAMPUSHIRE_DOMAIN};

    location = /nginx-health {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${CAMPUSHIRE_DOMAIN};

    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_session_cache   shared:SSL:20m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    client_max_body_size 26m;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;

    proxy_http_version 1.1;
    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host  $http_host;
    proxy_set_header Connection        "";
    proxy_connect_timeout 5s;

    # Operational endpoints stay on the internal network.
    location /actuator/ {
        return 404;
    }

    # Server-Sent Events: no buffering, long-lived connections.
    location = /api/v1/notifications/stream {
        limit_req zone=api_per_client burst=${NGINX_API_BURST} nodelay;
        proxy_pass http://campushire_api;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 1h;
        add_header X-Accel-Buffering no;
    }

    location /api/ {
        limit_req zone=api_per_client burst=${NGINX_API_BURST} nodelay;
        limit_req zone=api_per_ip burst=${NGINX_API_IP_BURST} nodelay;
        proxy_pass http://campushire_api;
        proxy_read_timeout 120s;
        proxy_next_upstream error timeout http_502 http_503;
        proxy_next_upstream_tries 2;
    }

    # Keycloak runs with KC_HTTP_RELATIVE_PATH=/auth behind this proxy.
    location /auth/ {
        limit_req zone=auth_per_ip burst=${NGINX_AUTH_BURST} nodelay;
        proxy_pass http://campushire_keycloak;
        proxy_buffer_size 128k;
        proxy_buffers 4 256k;
        proxy_busy_buffers_size 256k;
    }

    # Admin console and admin REST API: private networks only.
    location /auth/admin/ {
        allow 10.0.0.0/8;
        allow 172.16.0.0/12;
        allow 192.168.0.0/16;
        allow 127.0.0.1;
        deny all;
        proxy_pass http://campushire_keycloak;
        proxy_buffer_size 128k;
        proxy_buffers 4 256k;
        proxy_busy_buffers_size 256k;
    }

    # Grafana (compose profile "monitoring"): private networks only. Resolved per request, so nginx starts (and
    # answers 502 here) when the profile is not running.
    location /grafana/ {
        allow 10.0.0.0/8;
        allow 172.16.0.0/12;
        allow 192.168.0.0/16;
        allow 127.0.0.1;
        deny all;
        set $grafana_upstream http://grafana:3000;
        proxy_pass $grafana_upstream;
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
    }

    location /_next/static/ {
        proxy_pass http://campushire_web;
        expires 1y;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    location / {
        proxy_pass http://campushire_web;
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
    }
}
