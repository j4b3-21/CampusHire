// CampusHire delivery pipeline for the college server.
//
// Agent requirements: Docker Engine with Compose v2, JDK 25, Node.js 22, curl, jq.
// Credentials (Jenkins > Credentials):
//   campushire-prod-env   Secret file with the production deploy/.env (including OPENFGA_STORE_ID/MODEL_ID)
// The deploy stage runs on the host that serves CampusHire (label "campushire-prod"); BACKUP_DIR must be writable
// by the Jenkins user there. Set SMOKE_INSECURE=1 on that agent for self-signed (LAN) certificates.
// The compose project is fixed (campushire-prod), so Jenkins manages the same containers as a manual install; set
// CERTS_DIR in the credential to an absolute path because the workspace is not the install directory.

pipeline {
    agent { label 'campushire-build' }

    options {
        timestamps()
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '30'))
        timeout(time: 60, unit: 'MINUTES')
    }

    environment {
        IMAGE_TAG = "${env.GIT_COMMIT?.take(12) ?: env.BUILD_NUMBER}"
        COMPOSE_FILE = 'deploy/docker-compose.prod.yml'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Backend: build and test') {
            steps {
                sh 'chmod +x mvnw && ./mvnw -B verify'
            }
            post {
                always {
                    junit allowEmptyResults: true,
                          testResults: 'bm4a/platform/target/surefire-reports/*.xml, backend/target/surefire-reports/*.xml'
                }
            }
        }

        stage('Frontend: lint and build') {
            steps {
                dir('frontend') {
                    sh 'npm ci && npm run lint && npm run build'
                }
            }
        }

        // Images are built on the serving host: the frontend bakes CAMPUSHIRE_PUBLIC_URL (deploy/.env) into its
        // bundle, and the compose file runs whatever campushire-*:IMAGE_TAG exists locally.
        stage('Deploy') {
            when {
                branch 'main'
            }
            agent { label 'campushire-prod' }
            steps {
                withCredentials([file(credentialsId: 'campushire-prod-env', variable: 'PROD_ENV')]) {
                    sh '''
                        install -m 600 "$PROD_ENV" deploy/.env
                        export IMAGE_TAG
                        docker compose -f "$COMPOSE_FILE" --env-file deploy/.env config -q
                        docker compose -f "$COMPOSE_FILE" --env-file deploy/.env build --pull
                        deploy/scripts/openfga-bootstrap.sh --check
                        deploy/scripts/backup.sh
                        docker compose -f "$COMPOSE_FILE" --env-file deploy/.env up -d --remove-orphans --wait
                    '''
                }
            }
            post {
                cleanup {
                    sh 'rm -f deploy/.env'
                }
            }
        }

        stage('Smoke test') {
            when {
                branch 'main'
            }
            agent { label 'campushire-prod' }
            steps {
                withCredentials([file(credentialsId: 'campushire-prod-env', variable: 'PROD_ENV')]) {
                    sh '''
                        install -m 600 "$PROD_ENV" deploy/.env
                        deploy/scripts/smoke-test.sh ${SMOKE_INSECURE:+--insecure}
                    '''
                }
            }
            post {
                cleanup {
                    sh 'rm -f deploy/.env'
                }
            }
        }
    }

    post {
        failure {
            echo 'Pipeline failed. The previous containers keep serving traffic; see the stage logs above.'
        }
        cleanup {
            sh 'rm -f deploy/.env || true'
        }
    }
}
