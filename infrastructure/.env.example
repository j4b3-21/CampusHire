# CampusHire local infrastructure - DEVELOPMENT ONLY placeholder values.
# Copy to infrastructure/.env (make infra-up does this on first run). Never commit infrastructure/.env.
# The placeholders work as-is for local development; keep backend/.env in sync if you change them.

# PostgreSQL superuser (used only by the container and init script)
POSTGRES_DB=postgres
POSTGRES_USER=campushire_admin
POSTGRES_PASSWORD=change-me-postgres

# Keycloak database
KEYCLOAK_DB=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=change-me-keycloak-db

# OpenFGA database
OPENFGA_DB=openfga
OPENFGA_DB_USER=openfga
OPENFGA_DB_PASSWORD=change-me-openfga-db

# CampusHire API database (BM4A platform + CampusHire migrations)
PLATFORM_DB=campushire
PLATFORM_DB_USER=campushire
PLATFORM_DB_PASSWORD=change-me-campushire-db

# NOTE: the database variables above are applied by postgres/init/01-init.sh
# only when the postgres volume is first created (make infra-reset recreates it).

# Keycloak bootstrap admin (http://localhost:8180/admin)
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-keycloak-admin
# Full public URL; fixes the token issuer to http://localhost:8180/realms/campushire
KC_HOSTNAME=http://localhost:8180
KC_HTTP_ENABLED=true

# Google sign-in (Keycloak identity provider "google"). Read only when the realm is first imported.
# Create an OAuth client at https://console.cloud.google.com/apis/credentials with redirect URI
# http://localhost:8180/realms/campushire/broker/google/endpoint, then set these and run make infra-reset.
GOOGLE_IDP_ENABLED=false
GOOGLE_CLIENT_ID=change-me-google-client-id
GOOGLE_CLIENT_SECRET=change-me-google-client-secret
GOOGLE_HOSTED_DOMAIN=iiitt.ac.in

# OpenFGA API pre-shared key (the API sends it as a bearer token)
OPENFGA_PRESHARED_KEY=change-me-openfga-key

# MinIO root credentials (console http://localhost:9101); used only by minio-init and humans
MINIO_ROOT_USER=campushire-minio
MINIO_ROOT_PASSWORD=change-me-minio-root

# S3 access key the API uses; minio-init creates it with read/write on S3_BUCKET only
S3_REGION=us-east-1
S3_BUCKET=campushire-files
S3_ACCESS_KEY=campushire-api
S3_SECRET_KEY=change-me-s3-secret

# Outgoing email (delivered to Mailpit, http://localhost:8025)
MAIL_FROM=placements@campushire.local

# Public URL of the web app, used in email links
APP_BASE_URL=http://localhost:3000

# --profile app only
RATE_LIMIT_ENABLED=true
BACKEND_HOST_PORT=8090
FRONTEND_HOST_PORT=3000
