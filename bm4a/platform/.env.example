# BM4A platform - local development settings.
# Copy to platform/.env (loaded automatically by the "local" profile) and keep
# the values in sync with infrastructure/.env. Never commit platform/.env.

PLATFORM_DB_HOST=localhost
PLATFORM_DB_PORT=2345
PLATFORM_DB=platform
PLATFORM_DB_USER=platform
PLATFORM_DB_PASSWORD=change-me-platform-db

KEYCLOAK_HOST=localhost
KEYCLOAK_PORT=2346
KEYCLOAK_REALM=bm4a
KEYCLOAK_AUDIENCE=bm4a-api

OPENFGA_API_URL=http://localhost:2347
OPENFGA_PRESHARED_KEY=change-me-openfga-key
OPENFGA_STORE_NAME=bm4a

REDIS_HOST=localhost
REDIS_PORT=2349
