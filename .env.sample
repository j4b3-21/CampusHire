# Database
DB_URL=jdbc:postgresql://localhost:5432/campushire
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Server
SERVER_PORT=8080

# Keycloak
KEYCLOAK_CLIENT_ID=campushire-crm

KEYCLOAK_AUTHORIZATION_URI=http://localhost:8765/realms/campushire/protocol/openid-connect/auth
KEYCLOAK_TOKEN_URI=http://localhost:8765/realms/campushire/protocol/openid-connect/token
KEYCLOAK_USER_INFO_URI=http://localhost:8765/realms/campushire/protocol/openid-connect/userinfo
KEYCLOAK_JWK_SET_URI=http://localhost:8765/realms/campushire/protocol/openid-connect/certs
KEYCLOAK_LOGOUT_URI=http://localhost:8765/realms/campushire/protocol/openid-connect/logout

# Frontend
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
APP_POST_LOGIN_REDIRECT_URI=http://localhost:5173/
APP_POST_LOGOUT_REDIRECT_URI=http://localhost:5173/